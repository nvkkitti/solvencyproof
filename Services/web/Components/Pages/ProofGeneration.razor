@page "/proof-generation"
@rendermode InteractiveServer
@using SolvencyProof.Models
@using SolvencyProof.Services
@using Microsoft.EntityFrameworkCore
@inject IAuditProverService AuditProver
@inject ILogger<ProofGeneration> Logger
@inject IDbContextFactory<SolvencyProofContext> DbFactory

<PageTitle>Bizonyítás generálása</PageTitle>

<h3>Fizetőképesség igazolásnak generálása</h3>

<button class="btn btn-primary mb-3" @onclick="RunAuditAsync" disabled="@_isProcessing">
    @(_isProcessing ? "Folyamatban..." : "Audit indítása")
</button>

@if (_currentStep > 0)
{
    <ol class="list-group mb-3">
        @for (int i = 0; i < _stepTitles.Length; i++)
        {
            int step = i + 1;
            <li class="list-group-item d-flex align-items-center gap-2">
                @if (_failedStep == step)
                {
                    <span class="text-danger fw-bold" aria-label="hiba">&#10007;</span>
                }
                else if (_currentStep > step)
                {
                    <span class="text-success fw-bold" aria-label="kész">&#10003;</span>
                }
                else if (_currentStep == step && _isProcessing)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-label="folyamatban"></span>
                }
                else
                {
                    <span class="text-muted">&#9675;</span>
                }
                <span>@step. @_stepTitles[i]</span>
            </li>
        }
    </ol>
}

@if (_result is not null)
{
    <div class="alert alert-success mt-2">
        Sikeres audit! A fizetőképességi bizonyítékot a blokklánc ellenőrizte.<br />
        Merkle root: <code>@_result.MerkleRoot</code><br />
        Tranzakciós hash: <code>@_result.TransactionHash</code>
    </div>
}

@if (_errorMessage is not null)
{
    <div class="alert alert-danger mt-2">@_errorMessage</div>
}

@code {
    private static readonly string[] _stepTitles =
    [
        "Adatbázis-lekérdezés (ügyfélegyenlegek)",
        "Bizonyíték generálása (Rust Axum, zk-STARK)",
        "Blokklánc-tranzakció (Hardhat JSON-RPC)",
        "On-chain ellenőrzés (ProofOfSolvency + MockStarkVerifier)"
    ];

    private bool _isProcessing;
    private int _currentStep;
    private int _failedStep;
    private AuditProofResult? _result;
    private string? _errorMessage;

    private async Task RunAuditAsync()
    {
        _isProcessing = true;
        _currentStep = 1;
        _failedStep = 0;
        _result = null;
        _errorMessage = null;

        // Progress<T> posts to the captured context; marshal to the Blazor renderer explicitly (A Blazor renderer szálára kell váltani)
        var progress = new Progress<AuditProgressReport>(report => _ = InvokeAsync(() =>
        {
            _currentStep = report.StepIndex;
            StateHasChanged();
        }));

        try
        {
            await using SolvencyProofContext db = await DbFactory.CreateDbContextAsync();
            var audit = new SolvencyAudit
            {
                Id = Guid.NewGuid(),
                Timestamp = DateTime.UtcNow,
                Status = AuditStatus.Prepared
            };
            db.SolvencyAudit.Add(audit);
            await db.SaveChangesAsync();

            _result = await AuditProver.GenerateProofAsync(audit.Id, progress);
            _currentStep = AuditProgressReport.TotalSteps + 1;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "A bizonyítás generálása sikertelen (lépés: {Step}).", _currentStep);
            _failedStep = _currentStep;
            _errorMessage = "A bizonyítás generálása sikertelen. Részletek a naplóban.";
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
