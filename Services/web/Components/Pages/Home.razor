@page "/"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SolvencyProofContext> DbFactory
@inject SolvencyProof.Services.ZkProofClient ZkProofClient

<PageTitle>Fizetőképesség igazolása</PageTitle>

<div class="container-fluid mt-2">
    <!-- Fő szekció -->
    <div class="p-5 mb-3 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-2">
            <h1 class="display-5 fw-bold text-dark">
                Nullaismeretű kriptográfiai bizonyítás a fizetőképességről
            </h1>
            <p class="col-md-10 fs-5 text-muted mt-3">
                Kriptográfiai igazolás a fizetőképességről adatminimalizációval.
                A rendszer Merkle-fák és Rust-alapú zk-STARK technológia kombinációjával biztosítja a pénzügyi átláthatóságot, az ügyfelek adatvédelme mellett.
            </p>
            <a href="/proof-generation" class="btn btn-primary btn-lg mt-3 shadow-sm">
                Bizonyítás generálása
            </a>

            <a href="/clientverification" class="btn btn-outline-secondary btn-lg mt-3 ms-2 shadow-sm">
                Azonosító hitelesítése
            </a>
        </div>
    </div>

    <!-- Statisztikai kártyák -->
    <div class="row g-4 mb-4">
        <!-- 1. Kártya: Rendszer állapota -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-bottom @(_rustConnection == true ? "border-success" : "border-danger") border-3">
                <div class="card-body text-center">
                    <h6 class="text-uppercase text-muted fw-bold mb-3">Rendszer állapota</h6>
                    @if (_isCheckingRust)
                    {
                        <h2 class="display-6 fw-bold text-secondary mb-0">Ellenőrzés...</h2>
                        <p class="card-text text-muted mt-2">C# backend &rarr; Rust zkVM prover</p>
                    }
                    else if (_rustConnection == true)
                    {
                        <h2 class="display-6 fw-bold text-success mb-0">Kapcsolódva</h2>
                        <p class="card-text text-muted mt-2">A C# backend eléri a Rust zkVM provert.</p>
                    }
                    else
                    {
                        <h2 class="display-6 fw-bold text-danger mb-0">Nem érhető el</h2>
                        <p class="card-text text-muted mt-2">A Rust zkVM prover nem válaszol.</p>
                    }

                    <button class="btn btn-sm btn-outline-secondary mt-2"
                            type="button"
                            @onclick="CheckRustConnectionAsync"
                            disabled="@_isCheckingRust">
                        @(_isCheckingRust ? "Ellenőrzés..." : "Újraellenőrzés")
                    </button>
                </div>
            </div>
        </div>

        <!-- 2. Kártya: Utolsó Merkle root -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-bottom border-primary border-3">
                <div class="card-body text-center">
                    <h6 class="text-uppercase text-muted fw-bold mb-3">
                        Utolsó Audit (Merkle Root)
                    </h6>

                    <h2 class="fs-3 fw-bold text-dark mb-0 font-monospace">
                        0x8f4...2b9c
                    </h2>
                    <p class="card-text text-muted mt-2">Utolsó Merkle root</p>
                </div>
            </div>
        </div>

        <!-- 3. Kártya: Adatbázis statisztika -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-bottom border-info border-3">
                <div class="card-body text-center">
                    <h6 class="text-uppercase text-muted fw-bold mb-3">Ellenőrzött azonosítók</h6>
                    <h2 class="display-6 fw-bold text-info mb-0">@_verificationQueryCount.ToString("N0")</h2>
                    <p class="card-text text-muted mt-2">Off-chain EF Core adatbázisból</p>
                </div>
            </div>

@code {
    private long _verificationQueryCount;
    private bool? _rustConnection;
    private bool _isCheckingRust;

    protected override async Task OnInitializedAsync()
    {
        await using SolvencyProofContext db = await DbFactory.CreateDbContextAsync();
        _verificationQueryCount = await db.VerificationQueries.LongCountAsync();
        await CheckRustConnectionAsync();
    }

    private async Task CheckRustConnectionAsync()
    {
        _isCheckingRust = true;

        try
        {
            _rustConnection = await ZkProofClient.IsRustAvailableAsync();
        }
        finally
        {
            _isCheckingRust = false;
        }
    }
}
        </div>
    </div>

    <!-- Rendszernapló vagy információs panel? -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white fw-bold">
            Rendszer komponensek állapota
        </div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>C# .NET Entity Framework adatbázis</span>

                    <span class="badge bg-success rounded-pill d-inline-flex align-items-center gap-2"
                          role="status"
                          aria-live="polite">
                        <span class="bg-white rounded-circle"
                              style="width: 0.5rem; height: 0.5rem;"
                              aria-hidden="true"></span>
                        Kapcsolódva
                    </span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Rust zkVM Prover (STARK)
                    <span class="badge bg-success rounded-pill">Elérhető</span>
                </li>
            </ul>
        </div>
    </div>
</div>