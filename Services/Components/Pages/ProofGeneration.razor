@page "/proof-generation"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<h3>Proof of Solvency - Bizonyítás generálása</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GenerateProofAsync" disabled="@_isProcessing">
        @if (_isProcessing)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span class="ms-2"> zk-STARK bizonyítás generálása (RUST)... </span>
        }
        else
        {
            <span>  Proof of Solvency futtatása</span>
        }
    </button>
</div>

@if (_proofResult != null)
{
    <div class="alert alert-success mt-2">  
        Sikeres generálés! Merkle root: <strong>@_proofResult</strong>
    </div>
}

@if (_errorMessage != null)
{
    <div class="alert alert-danger mt-2">@_errorMessage</div>
}

@code 
{
    private bool _isProcessing = false;
    private string? _proofResult;
    private string? _errorMessage;

    private async Task GenerateProofAsync()
    {
        _isProcessing = true;
        _proofResult = null;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            HttpClient client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(NavigationManager.BaseUri);

            using HttpResponseMessage response = await client.PostAsync("api/audit/generate", content: null);
            response.EnsureSuccessStatusCode();

            AuditGenerationResponse? result = await response.Content.ReadFromJsonAsync<AuditGenerationResponse>();
            if (result is null)
            {
                throw new InvalidOperationException("A REST API üres választ adott.");
            }

            _proofResult = $"0x{result.MerkleRoot}";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Hiba: {ex.Message}");
            _errorMessage = "A bizonyítás generálása sikertelen. Kérjük, próbálja újra később.";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private sealed record AuditGenerationResponse(Guid Id, string Status, DateTime Timestamp, decimal TotalAssets, string MerkleRoot);
}
