@page "/solvencyaudits/delete"
@using Microsoft.EntityFrameworkCore
@using SolvencyProof.Models
@inject IDbContextFactory<SolvencyProofContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>SolvencyAudit</h2>
    <hr />
    @if (solvencyaudit is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Timestamp</dt>
            <dd class="col-sm-10">@solvencyaudit.Timestamp</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">TotalLiabilities</dt>
            <dd class="col-sm-10">@solvencyaudit.TotalLiabilities</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">TotalAssets</dt>
            <dd class="col-sm-10">@solvencyaudit.TotalAssets</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">MerkleRoot</dt>
            <dd class="col-sm-10">@solvencyaudit.MerkleRoot</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CommitmentCv</dt>
            <dd class="col-sm-10">@solvencyaudit.CommitmentCv</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CommitmentCt</dt>
            <dd class="col-sm-10">@solvencyaudit.CommitmentCt</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CommitmentCDelta</dt>
            <dd class="col-sm-10">@solvencyaudit.CommitmentCDelta</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ZkProof</dt>
            <dd class="col-sm-10">@solvencyaudit.ZkProof</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@solvencyaudit.Status</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Secret</dt>
            <dd class="col-sm-10">@solvencyaudit.Secret</dd>
        </dl>
        <EditForm method="post" Model="solvencyaudit" OnValidSubmit="DeleteSolvencyAudit" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(solvencyaudit is null)">Delete</button> |
            <a href="/solvencyaudits">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private SolvencyAudit? solvencyaudit;

    [SupplyParameterFromQuery]
    private System.Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        solvencyaudit = await context.SolvencyAudit.FirstOrDefaultAsync(m => m.Id == Id);

        if (solvencyaudit is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteSolvencyAudit()
    {
        using var context = DbFactory.CreateDbContext();
        context.SolvencyAudit.Remove(solvencyaudit!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/solvencyaudits");
    }
}
